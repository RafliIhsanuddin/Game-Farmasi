  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Class:</b> Macrolide antibiotic





    <b>Indications:</b>

    Treatment
    of upper and lower respiratory tract infections, acute otitis media, skin and
    soft tissue infections, sexually transmitted infections (chlamydia), and typhoid
    fever





    <b>Target Bacteria:</b>

    Streptococcus pneumoniae, Haemophilus
    influenzae, Mycoplasma pneumoniae, Chlamydia trachomatis, Legionella pneumophila





    <b>Adverse
    Drug Reactions (ADR):</b>

    Gastrointestinal disturbances, headache, dizziness,
    QT interval prolongation





    <b>LINK:</b>

    <link="https://www.rxlist.com/zithromax-drug.htm">Click
    here to see more</link>

'
