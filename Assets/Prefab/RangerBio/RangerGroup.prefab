  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Class:</b> \u03B2-lactam antibiotic; third-generation cephalosporin\r\n\r\n<b>Indications:</b>\r\nTreatment
    of urinary tract infections, acute otitis media, pharyngitis and tonsillitis,
    bronchitis, mild community-acquired pneumonia, typhoid fever, and uncomplicated
    gonorrhea\r\n\r\n<b>Target Bacteria:</b>\r\nEscherichia coli, Klebsiella pneumoniae,
    Proteus mirabilis, Haemophilus influenzae, Neisseria gonorrhoeae, Salmonella
    typhi\r\n\r\n<b>Adverse Drug Reactions (ADR):</b>\r\nDiarrhea, nausea, vomiting,
    abdominal pain, skin rash, hypersensitivity reactions\r\n\r\n<b>LINK:</b>\r\n<link=\"https://www.rxlist.com/suprax-drug.htm\">Click
    here to see more</link>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c8f5a22c0014f7d46916b52ece690b42, type: 2}
