  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Pseudomonas aeruginosa (Gram-negative)</b>\r\n\r\n<b>Brief Characteristics:</b>\r\n\r\n-
    Gram-negative bacilli  \r\n\r\n- Opportunistic pathogen  \r\n\r\n- Strong biofilm
    formation \r\n \r\n- Characteristic grape-like odor  \r\n\r\n<b>Habitat:</b>\r\n\r\n-
    Water  \r\n\r\n- Hospital environments \r\n \r\n- Medical devices  \r\n\r\n<b>Major
    Diseases:</b>\r\n\r\n- Nosocomial pneumonia  \r\n\r\n- Burn wound infections 
    \r\n\r\n- Catheter-associated urinary tract infections  \r\n\r\n- Sepsis  \r\n\r\n-
    Malignant otitis externa  \r\n\r\n<b>Effective Antibiotics:</b>\r\n\r\n- Ciprofloxacin 
    \r\n\r\n- Levofloxacin  \r\n\r\n- Ceftazidime  \r\n\r\n- Cefepime  \r\n\r\n-
    Piperacillin\u2013tazobactam  \r\n\r\n- Meropenem  \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c8f5a22c0014f7d46916b52ece690b42, type: 2}
