--- !u!114 &7695476161364673887
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4266131982795439337}
  m_Enabled: 1
  m_EditorHideFlags: 0
