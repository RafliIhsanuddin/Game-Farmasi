  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Chronic bronchitis is caused by several interacting factors, including
    inhalation of noxious agents (most prominent are cigarette smoke and\r\nexposure
    to occupational dusts, fumes, and environmental pollution) and host factors including
    genetic factors and bacterial (and possibly viral)\r\ninfections. The hallmark
    of this disease is a chronic cough, accompanied by excessive production, and
    expectoration of sputum with a persistent presence of microorganisms in the patient\u2019s
    sputum.\r\n\r\nCommon bacterial pathogens include Haemophilus influenzae (H.
    influenzae), Moraxella catarrhalis (M. catarrhalis), and Streptococcus pneumoniae
    (S. pneumoniae).\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
