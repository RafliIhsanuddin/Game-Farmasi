  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Pneumonia developing outside the hospital or <48 hours after hospital
    admission. The causative pathogen in CAP in adult patients is most commonly viral,
    with human rhinovirus and influenza most common. The most prominent bacterial
    pathogen causing CAP in otherwise healthy adults is S. pneumoniae accounting
    for up to 35% of all acute cases.  Other common pathogens include H. influenzae
    (2.5%\u201345%) and the atypical pathogens M. pneumoniae, Legionella species,
    and C. pneumoniae (about 20%)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
  m_sharedMaterial: {fileID: 4947494457033249829, guid: 3914de223fa8efc4787902589e5d6968, type: 2}
