  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Pink is a character to Mushroom, menghadirkan nuansa lembut, hangat, dan
    hidup pada bentuk serta kehadiran Mushroom yang biasanya diasosiasikan dengan
    alam, tanah, dan keteduhan. Warna Pink memberi sentuhan personalitas yang manis
    dan hampir lugu, seakan mengangkat Mushroom dari sekadar objek organisme menjadi
    sosok yang dapat dirasakan kehadirannya. Dalam sentuhan itu terdapat rasa penasaran
    yang pelan, yang membuat Mushroom bukan hanya bagian dari lanskap tetapi menjadi
    tokoh kecil yang menandai suasana. Pink memberi Mushroom sisi playful dan imajinatif,
    namun tidak mencabut identitas organiknya. Kesan tanah, lembap, dan hening khas
    Mushroom justru menjadi kanvas bagi Pink untuk mengekspresikan kehangatan dan
    keriangan, menghasilkan perpaduan yang tak terduga antara kesederhanaan dunia
    alam dan kejenakaan warna. Melalui hubungan ini, Mushroom menjadi lebih mudah
    diterima secara emosional, lebih mudah diingat, dan lebih dekat dengan karakter
    manusiawi tanpa kehilangan akar ekologisnya. Dalam hubungan keduanya, Pink berfungsi
    sebagai penyeimbang yang memperkaya cerita visual, menyampaikan bahwa kehadiran
    sesuatu yang lembut tidak selalu berarti rapuh dan kehadiran sesuatu yang membumi
    tidak selalu berarti keras. Pink menambahkan daya tarik yang menyentuh, membuat
    Mushroom memperoleh ekspresi dan makna baru, seakan memberi ruang bagi penonton
    untuk menafsirkan Mushroom sebagai sosok dengan perasaan, bukan hanya bentuk.
    Hasilnya, Mushroom tampil bukan sekadar elemen alam, tetapi karakter yang memiliki
    daya tarik, emosi, dan narasi.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c8f5a22c0014f7d46916b52ece690b42, type: 2}
