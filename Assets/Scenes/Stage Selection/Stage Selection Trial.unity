  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Class:<b> \u03B2-lactam antibiotic; aminopenicillin\r\n<b>Indications:<b>\nTreatment
    of acute otitis media, pharyngitis and tonsillitis, lower respiratory tract infections,
    skin and skin structure infections, urinary tract infections, acute uncomplicated
    gonorrhea, typhoid fever, Helicobacter pylori infection, and duodenal ulcer disease
    (as part of combination therapy)\n\r\n<b>Target Bacteria:<b>\nStreptococcus pneumoniae,
    Streptococcus pyogenes, Enterococcus faecalis, Haemophilus influenzae, Escherichia
    coli, Helicobacter pylori\n\r\n<b>Adverse Drug Reactions (ADR):<b>\r\nNausea,
    vomiting, diarrhea, skin rash, hypersensitivity reactions, including anaphylaxis
    (rare)\n\r\n<b>LINK:<b>\r\n\n\n<link=\"https://www.rxlist.com/amoxicillin/generic-drug.htm\"><color=#3ABEFF><u>
    https://www.rxlist.com/amoxicillin/generic-drug.htm</u></color></link>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c8f5a22c0014f7d46916b52ece690b42, type: 2}
